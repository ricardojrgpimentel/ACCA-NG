    <string name="current_measure_unit_preference_title">Unidade da corrente lida</string>
    <string name="current_measure_unit_preference_description">O ACC obtém informações de carregamento da interface sys. Alguns sistemas indicam a corrente em µA (microamperes), outros em mA (miliamperes). Se a unidade detetada estiver incorreta, podes defini-la manualmente.</string>
    <string name="voltage_measure_unit_preference_title">Unidade da tensão lida</string>
    <string name="voltage_measure_unit_preference_title_description">O ACC obtém informações de carregamento da interface sys. Alguns sistemas indicam a tensão em µV (microvolts), outros em mV (milivolts). Se a unidade detetada estiver incorreta, podes defini-la manualmente.</string>
