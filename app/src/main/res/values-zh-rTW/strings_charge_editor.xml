<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="preset_daily_help">適合日常使用，充電限制適中。</string>
    <string name="preset_plugged_help">適合長時間連接充電器的手機。保持電池電量較低；不保證可繞過。</string>
    <string name="preset_travel_help">適合外出前需要更多電量的情況。允許更高的充電電量。</string>
    <string name="charge_limits_title">電池充電限制 (%)</string>
    <string name="charge_limits_help">所有數值均為電池電量百分比。恢復充電需要連接充電器並且溫度適宜。ACC 必須運行以執行這些限制。</string>
    <string name="charge_pause_label">停止充電於</string>
    <string name="charge_pause_help">當電池達到此電量時暫停充電。</string>
    <string name="charge_resume_label">恢復充電於</string>
    <string name="charge_resume_help">暫停後，當電池下降至此電量或以下時恢復充電。</string>
    <string name="charge_shutdown_label">關閉手機於</string>
    <string name="charge_shutdown_help">當電池不在充電且電量降至此水平或以下時關閉手機。這不僅僅是暫停充電。</string>
    <string name="charge_cycle_summary">充電在 %1$d%% 停止，並在 %2$d%% 或以下恢復。</string>
    <string name="charge_unlimited_summary">∞ 作為停止表示移除基於電池百分比的停止限制。∞ 作為恢復允許在任何電池電量下恢復充電。</string>
    <string name="charge_percentage_value">%1$d%%</string>
    <string name="charge_temperature_value">%1$d °C</string>
    <string name="charge_seconds_value">%1$d 秒</string>
    <string name="charge_limit_disabled">此模式的充電限制已被禁用。</string>
    <string name="charge_unlimited_hint">∞ 表示禁用的百分比閾值。</string>
    <string name="charge_restore_limits">恢復初始充電限制</string>
    <string name="charge_switch_label">充電控制方式</string>
    <string name="charge_switch_help">ACC 使用相容的裝置控制來啟動或暫停充電。除非您知道您的裝置需要哪種方式，否則請保持自動模式。</string>
    <string name="charge_switch_automatic">自動尋找相容方式</string>
    <string name="charge_power_title">電流和電壓限制</string>
    <string name="charge_max_current">最大電流 (mA)：</string>
</resources>
