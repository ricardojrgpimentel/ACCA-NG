<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="preset_daily_help">适合日常使用，充电限制适中。</string>
    <string name="preset_plugged_help">适合长时间连接充电器的手机。保持电池电量较低；不保证绕过。</string>
    <string name="preset_travel_help">外出前可用更多电量。允许更高的充电水平。</string>
    <string name="charge_limits_title">电池充电限制（%）</string>
    <string name="charge_limits_help">所有数值均为电池电量的百分比。恢复充电需要连接充电器并保持适宜温度。必须运行ACC才能执行这些限制。</string>
    <string name="charge_pause_label">停止充电于</string>
    <string name="charge_pause_help">当电池达到此电量时暂停充电。</string>
    <string name="charge_resume_label">恢复充电于</string>
    <string name="charge_resume_help">暂停后，当电池电量降至此水平或以下时恢复充电。</string>
    <string name="charge_shutdown_label">关闭手机于</string>
    <string name="charge_shutdown_help">如果电池未在充电，当电池电量达到此水平或以下时关闭手机。这不仅仅是暂停充电。</string>
    <string name="charge_cycle_summary">充电在 %1$d%% 时停止，并在 %2$d%% 或更低时恢复。</string>
    <string name="charge_unlimited_summary">停止为 ∞ 表示移除基于电池百分比的停止限制。恢复为 ∞ 表示在任何电池电量下都可以恢复充电。</string>
    <string name="charge_percentage_value">%1$d%%</string>
    <string name="charge_temperature_value">%1$d °C</string>
    <string name="charge_seconds_value">%1$d 秒</string>
    <string name="charge_limit_disabled">此配置文件的充电限制已禁用。</string>
    <string name="charge_unlimited_hint">∞ 表示禁用的百分比阈值。</string>
    <string name="charge_restore_limits">恢复初始充电限制</string>
    <string name="charge_switch_label">充电控制方法</string>
    <string name="charge_switch_help">ACC 使用兼容的设备控制来启用或暂停充电。除非你清楚你的设备需要哪种方法，否则请保持自动。</string>
    <string name="charge_switch_automatic">自动查找兼容的方法</string>
    <string name="charge_power_title">电流和电压限制</string>
    <string name="charge_max_current">最大电流（毫安）：</string>
</resources>
