<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Acca.About.Brand" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.035</item>
        <item name="android:textColor">@color/color_on_background</item>
    </style>
    <style name="TextAppearance.Acca.About.Body" parent="TextAppearance.Acca.Body">
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="TextAppearance.Acca.About.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.Acca.About.Eyebrow" parent="TextAppearance.Acca.About.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.Acca.About.Name" parent="TextAppearance.Acca.Title" />
    <style name="TextAppearance.Acca.About.Section" parent="TextAppearance.Acca.Title">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.Acca.About.Value" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/color_on_background</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>
    <style name="Widget.Acca.About.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/outline_subtle</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.Acca.About.Link" parent="">
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_primary_content</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="drawableEndCompat">@drawable/ic_about_external_link</item>
        <item name="drawableTint">@color/color_primary_content</item>
    </style>
    <style name="Widget.Acca.About.CreditLink" parent="Widget.Acca.About.Link">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/color_on_background</item>
    </style>
    <style name="Widget.Acca.About.Disclosure" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/color_on_background</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">end</item>
        <item name="icon">@drawable/ic_baseline_arrow_drop_down_24px</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="android:checkable">true</item>
        <item name="cornerRadius">0dp</item>
    </style>
</resources>
