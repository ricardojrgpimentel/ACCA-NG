<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".activities.AboutActivity" >
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/about_toolbar"
        style="?toolbarStyle"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/about_ng_title" />
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true" >
        <LinearLayout
            android:id="@+id/about_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp" >
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/about_app_mark"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/TextAppearance.Acca.About.Brand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/about_brand"
                android:text="@string/about_ng_brand" />
            <TextView
                style="@style/TextAppearance.Acca.About.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_ng_intro" />
            <TextView
                style="@style/TextAppearance.Acca.About.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/about_build_summary"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="28dp"
                tools:text="2.0.0-ng-debug · Debug" />
            <View
                style="@style/Widget.Acca.About.Divider" />
            <TextView
                style="@style/TextAppearance.Acca.About.Eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:id="@+id/about_maintained_by"
                android:text="@string/about_ng_maintained_by" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="top" >
                <TextView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/about_maintainer_avatar"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/about_ng_maintainer_initials"
                    android:textColor="@color/color_on_primary"
                    android:textSize="18sp" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" >
                    <TextView
                        style="@style/TextAppearance.Acca.About.Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_ng_maintainer" />
                    <TextView
                        style="@style/TextAppearance.Acca.About.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/about_ng_maintainer_role" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/about_maintainer_profile"
                        style="@style/Widget.Acca.About.Link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/about_ng_profile" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_project"
                style="@style/Widget.Acca.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_project"
                android:layout_marginTop="16dp"
                app:icon="@drawable/ic_github_mark"
                app:iconGravity="textStart" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_issues"
                style="@style/Widget.Acca.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_issues"
                android:layout_marginBottom="24dp" />
            <View
                style="@style/Widget.Acca.About.Divider" />
            <TextView
                style="@style/TextAppearance.Acca.About.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:id="@+id/about_origin"
                android:text="@string/about_ng_origin" />
            <TextView
                style="@style/TextAppearance.Acca.About.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_ng_origin_blurb" />
            <TextView
                style="@style/TextAppearance.Acca.About.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/about_ng_original_team" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/about_matte_profile"
                style="@style/Widget.Acca.About.CreditLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_matte" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/about_squabbi_profile"
                style="@style/Widget.Acca.About.CreditLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_squabbi" />
            <TextView
                style="@style/TextAppearance.Acca.About.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/about_ng_acc_author" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/about_vr25_profile"
                style="@style/Widget.Acca.About.CreditLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_vr25" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/about_original_project"
                style="@style/Widget.Acca.About.Link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_original_project"
                android:layout_marginTop="8dp" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/about_community"
                style="@style/Widget.Acca.About.Link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_community"
                android:layout_marginBottom="20dp" />
            <View
                style="@style/Widget.Acca.About.Divider" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_technical_toggle"
                style="@style/Widget.Acca.About.Disclosure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_technical" />
            <LinearLayout
                android:id="@+id/about_technical_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="20dp"
                android:visibility="gone" >
                <TextView
                    style="@style/TextAppearance.Acca.About.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_ng_app_version" />
                <TextView
                    style="@style/TextAppearance.Acca.About.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/about_acca_version_tv"
                    tools:text="2.0.0-ng-debug (40)" />
                <TextView
                    style="@style/TextAppearance.Acca.About.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/about_ng_acc_version" />
                <TextView
                    style="@style/TextAppearance.Acca.About.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/about_acc_daemon_version_tv"
                    android:text="@string/about_ng_loading"
                    android:accessibilityLiveRegion="polite" />
                <TextView
                    style="@style/TextAppearance.Acca.About.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/about_ng_api_version" />
                <TextView
                    style="@style/TextAppearance.Acca.About.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/about_acc_api_version_tv"
                    android:text="@string/about_ng_loading"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <View
                style="@style/Widget.Acca.About.Divider" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_licenses_toggle"
                style="@style/Widget.Acca.About.Disclosure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_ng_licenses" />
            <LinearLayout
                android:id="@+id/about_licenses_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp"
                android:visibility="gone" >
                <TextView
                    style="@style/TextAppearance.Acca.About.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_ng_license_blurb" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/about_license"
                    style="@style/Widget.Acca.About.Link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_ng_view_license" />
                <TextView
                    style="@style/TextAppearance.Acca.About.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/about_ng_attributions" />
            </LinearLayout>
            <View
                style="@style/Widget.Acca.About.Divider" />
            <TextView
                style="@style/TextAppearance.Acca.About.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/about_ng_footer" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
